{
  "format": "gelab-zero-4b-npu-deployment-v1",
  "profile": "g32x18-fp16-bsc-matmul-runtime-s256-grouped-gqa-llamacpp-q4_k_m",
  "model_path": "model/checkpoint",
  "runtime_assets_dir": "model/runtime",
  "api": {
    "model_id": "gelab-zero-4b",
    "max_request_bytes": 33554432,
    "remote_media": {
      "enabled": true,
      "timeout_seconds": 30,
      "max_bytes": 33554432
    }
  },
  "tfdl": {
    "addon": "runtime/libTFDLAddOn.so",
    "vision": {
      "graph_layout": "single-logical-graph-external-parameters",
      "precision": "fp16",
      "graph_construction": "direct-TFContext-Vit.py-style",
      "main_trunk_layout": "BSC",
      "projection_input_layout": "A[B,S,K]",
      "parameterized_linear_lowering": "MatMul",
      "projection_layout": "A[B,S,K] @ W[K,N]",
      "projection_trans_a": false,
      "projection_trans_b": false,
      "height": 512,
      "width": 288,
      "grid_h": 32,
      "grid_w": 18,
      "fps": 2.0,
      "min_frames": 2,
      "max_frames": 8,
      "fb_dir": "model/vision/single-g32x18-fp16-bsc-matmul-runtime",
      "runtime_profile": "S576 visual grid, S144 merged visual tokens",
      "executor": {
        "UseHardware": true,
        "FrugalMode": true,
        "Core": [0,1,2,3,4,5,6,7],
        "cpuLimit": 32,
        "useCache": true,
        "optimize": {
          "MakeAlign": true,
          "MakeUnfold": true,
          "RuntimeQuantMatMul":true
        }
      }
    },
    "prefill": {
      "precision": "fp16",
      "seq_len": 256,
      "fb_dir": "model/prefill/s256-fp16-masksoftmax-grouped-gqa",
      "main_trunk_layout": "BSC",
      "projection_operator": "MatMul",
      "projection_layout": "A[B,S,K] @ W[K,N]",
      "projection_trans_a": false,
      "projection_trans_b": false,
      "attention": "grouped GQA: QK -> scalar head scale -> MaskSoftmax -> AV",
      "gqa": {
        "query_heads": 32,
        "kv_heads": 8,
        "kv_repeats": 4,
        "materialized_kv_repeat": false
      },
      "attention_optimizer_rewrite": false,
      "prefill_chunk_layers": 8,
      "executor": {
        "UseHardware": true,
        "FrugalMode": true,
        "Core": [0,1,2,3,4,5,6,7],
        "cpuLimit": 32,
        "useCache": true,
        "optimize": {
          "MakeAlign": true,
          "MakeUnfold": true,
          "RuntimeQuantMatMul":true
        }
      }
    }
  },
  "decode": {
    "engine": "llama.cpp-external-kv",
    "precision": "Q4_K_M",
    "cache_dtype": "float16",
    "decoder_dir": "model/decode/llmdecode-q4_k_m",
    "threads": 32,
    "valid_kv_length": "per-request attention_mask.sum()",
    "max_new_tokens": 1024
  }
}
